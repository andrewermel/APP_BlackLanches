<p style="color: green"><%= notice %></p>

<% content_for :title, "Lanches" %>

<div class="lanches-header">
  <h1>🍔 <%= t('lanches.title') %></h1>
  <%= link_to "➕ #{t('lanches.new')}", new_lanch_path, class: "btn btn-primary" %>
</div>

<% if @lanches.any? %>
  <div class="lanches-grid">
    <% @lanches.each do |lanch| %>
      <div class="lanche-card">
        <!-- Foto principal do lanche -->
        <% if lanch.fotos.attached? && lanch.fotos.first.representable? %>
          <div class="lanche-foto">
            <%= image_tag lanch.fotos.first, 
                class: "lanche-imagem" %>
            <% if lanch.fotos.count > 1 %>
              <span class="foto-count">+<%= lanch.fotos.count - 1 %> fotos</span>
            <% end %>
          </div>
        <% else %>
          <div class="lanche-sem-foto">
            <div>
              📷 Sem foto
            </div>
          </div>
        <% end %>
        
        <div class="lanche-content" style="padding: 15px;">
          <h3><%= lanch.nome %></h3>
          
          <% if lanch.ingredientes.present? %>
            <p class="ingredientes"><em><%= truncate(lanch.ingredientes, length: 100) %></em></p>
          <% end %>
        
        <div class="lanche-info">
          <p><strong><%= t('lanches.portions') %>:</strong> 
            <%= lanch.lanche_porcaos.sum(:quantidade) %> <%= t('lanches.units') %> 
            (<%= lanch.lanche_porcaos.count %> <%= t('lanches.types') %>)
          </p>
          
          <% if lanch.lanche_porcaos.any? %>
            <div class="porcoes-list">
              <small>
                <% lanch.lanche_porcaos.each do |lanche_porcao| %>
                  • <%= lanche_porcao.quantidade %>x 
                    <%= lanche_porcao.porcao.nome || "#{lanche_porcao.porcao.item.nome} (#{lanche_porcao.porcao.peso_utilizado}kg)" %><br>
                <% end %>
              </small>
            </div>
          <% end %>
        </div>
        
        <div class="pricing">
          <p><strong><%= t('lanches.cost') %>:</strong> <span class="custo"><%= format_currency(lanch.custo) %></span></p>
          <p><strong><%= t('lanches.suggested_price') %>:</strong> <span class="preco-sugerido"><%= format_currency(lanch.preco_sugerido) %></span></p>
          <p><strong><%= t('lanches.sale_price') %>:</strong> <span class="valor-venda"><%= format_currency(lanch.valor_venda) %></span></p>
          <p><strong><%= t('lanches.profit') %>:</strong> <span class="lucro"><%= format_currency(lanch.lucro) %></span></p>
        </div>
        
          <div class="lanche-actions" style="margin-bottom: 10px;">
            <%= button_to "⬆️", move_up_lanch_path(lanch), method: :patch, class: "btn btn-warning btn-sm", title: t('common.move_up'), style: "display: inline-block; margin-right: 5px;", authenticity_token: true %>
            <%= button_to "⬇️", move_down_lanch_path(lanch), method: :patch, class: "btn btn-warning btn-sm", title: t('common.move_down'), style: "display: inline-block;", authenticity_token: true %>
          </div>
          <div class="lanche-actions">
            <%= link_to t('common.show'), lanch, class: "btn btn-info btn-sm" %>
            <%= link_to t('common.edit'), edit_lanch_path(lanch), class: "btn btn-warning btn-sm" %>
            <%= button_to t('common.delete'), lanch, method: :delete, 
                confirm: t('common.confirm_delete'), class: "btn btn-danger btn-sm", style: "display: inline-block;", authenticity_token: true %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p>Nenhum lanche cadastrado ainda.</p>
    <%= link_to "Criar primeiro lanche", new_lanch_path, class: "btn btn-primary" %>
  </div>
<% end %>

<div style="margin-top: 20px;">
  <%= link_to "← Voltar para Home", root_path, class: "btn btn-secondary" %>
</div>
